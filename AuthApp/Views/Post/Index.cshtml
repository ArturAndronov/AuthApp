@using System.Security.Claims
@model IEnumerable<AuthApp.Models.Post>

@{
    ViewData["Title"] = "Посты";
}

<div class="container">
    <h2 class="text-center mb-4">Посты</h2>
    <div class="text-center mb-4">
        <a asp-action="Create" class="btn btn-primary">Создать пост</a>
    </div>

    @foreach (var post in Model)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h3 class="card-title">@post.Title</h3>
                <p class="card-text">@post.Content</p>
                <p class="text-muted"><strong>Автор:</strong> @post.User?.Username</p>

                @if (post.UserId.ToString() == User.FindFirst(ClaimTypes.NameIdentifier)?.Value)
                {
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@post.Id" class="btn btn-warning">Редактировать</a>
                        <form asp-action="Delete" asp-route-id="@post.Id" method="post">
                            <button type="submit" class="btn btn-danger">Удалить</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }
</div>
